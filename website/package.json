{
  "name": "typing-pet-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4179",
    "sync-release": "node scripts/sync-release.mjs",
    "test": "node --test scripts/theme.test.mjs",
    "test:downloads": "python3 -m unittest discover -s scripts -p 'test_downloads.py' -v",
    "build": "tsc --noEmit && npm test && node scripts/check-analytics.mjs && vite build && vite build --ssr src/entry-server.tsx --outDir .runtime/ssr && node scripts/prerender.mjs && node scripts/check-locales.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4179"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "lucide-react": "1.61.0",
    "posthog-js": "1.438.21",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  }
}
